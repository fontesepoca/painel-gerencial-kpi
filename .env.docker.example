# Copie para .env na raiz do projeto na VM e preencha os valores reais.
# Nao versionar .env. Ele ja esta no .gitignore.

# Endereco publico que o navegador usara para chamar a API.
# Exemplo em teste direto por IP: http://192.168.0.227:5207
NEXT_PUBLIC_API_URL=http://SEU_IP_OU_DOMINIO:5207

# Origem publica do front liberada no CORS da API.
# Exemplo em teste direto por IP: http://192.168.0.227:3000
FRONTEND_ORIGIN=http://SEU_IP_OU_DOMINIO:3000

API_PORT=5207
CLIENT_PORT=3000

# String de conexao do Oracle. Preencha somente na VM.
# Exemplo de formato:
# User Id=USUARIO;Password=SENHA;Data Source=HOST:1521/SERVICO
ORACLE_EPOCA=
