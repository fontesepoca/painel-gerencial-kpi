# Copie para .env na raiz do projeto na VM e preencha os valores reais.
# Nao versionar .env. Ele ja esta no .gitignore.

# Endereco publico que o navegador usara para chamar a API.
# Exemplo em teste direto por IP: http://192.168.0.227:5207
NEXT_PUBLIC_API_URL=http://SEU_IP_OU_DOMINIO:5207

# Origem publica do front liberada no CORS da API.
# Exemplo em teste direto por IP: http://192.168.0.227:3000
FRONTEND_ORIGIN=http://SEU_IP_OU_DOMINIO:3000

API_PORT=5207
CLIENT_PORT=3000

# String de conexao do Oracle. Preencha somente na VM.
# Exemplo de formato:
# User Id=USUARIO;Password=SENHA;Data Source=HOST:1521/SERVICO
ORACLE_EPOCA=

# Chave que assina os tokens de login. OBRIGATORIA -- sem ela a API nao sobe.
# Gere uma sua e guarde so na VM:  openssl rand -base64 48
# Minimo 32 caracteres. Trocar a chave derruba todas as sessoes abertas.
JWT_CHAVE=

# Processos que o Oracle usa na consulta de faturamento do DRE.
# 4 e o padrao e foi medido: 2 entrega metade do ganho, 8 nao entrega nada alem de 4.
# 0 DESLIGA -- a consulta volta a ser exatamente a de antes. Ver docs/PARALELISMO.md.
GRAU_DE_PARALELISMO=4

# Compressao das respostas da API (gzip/brotli). Reduz o corpo do DRE em cerca de 9x.
# false devolve o pipeline ao que era antes. Ver docs/COMPRESSAO.md.
COMPRESSAO_HABILITADA=true
